# =============================================
# System & Editor files
# =============================================
Thumbs.db
desktop.ini
.DS_Store
*~
*.bak
*.tmp
*.swp
~$*.docx
~$*.xlsx
~$*.pptx

# =============================================
# SECRETS & CREDENTIALS — CRITICAL
# Never commit any of these to a public repo.
# =============================================
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx
*.p12
*.token
*.secret
*.password
secrets.*
credentials.*
id_rsa*
id_ed25519*
*.pub
# Azure / GCP / AWS credential files
.azure/
.gcloud/
.aws/
service-account*.json
*-key.json

# =============================================
# Agent runtime files — author-private
# AGENT_CONTEXT files accumulate session data.
# Keep them local; never push to public remote.
# =============================================
agent-context/
AGENT_LOG.md

# =============================================
# IDE & Editor caches
# =============================================
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# =============================================
# Logs & Runtime
# =============================================
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# =============================================
# Build & Dependencies
# =============================================
node_modules/
dist/
build/
coverage/
.cache/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

tests/evals/results/

# =============================================
# Client data — GDPR / confidentiality
# Source materials (transcripts, meeting notes)
# passed to skills must NEVER be committed.
# =============================================
*.vtt
!tests/fixtures/**
input/
source-materials/
client-data/
